# Backend
BACKEND_PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://synapsegrid_user:secure_password@localhost:5432/synapsegrid_db
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# Docker
DOCKER_SOCKET=/var/run/docker.sock

# Session
SESSION_TIMEOUT_MS=86400000
SESSION_CLEANUP_INTERVAL_MS=3600000

# Sandbox
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_IMAGE=node:20-alpine

# ============== Code Compiler ==============
COMPILER_TIMEOUT=30000
COMPILER_COMPILE_TIMEOUT=60000
COMPILER_TEMP_DIR=./temp_files

# ============== Code Assistant (AI) ==============
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7

# ============== Host Control ==============
HOST_CONTROL_PORT_START=3000
HOST_CONTROL_PORT_END=65535
HOST_CONTROL_HISTORY_SIZE=1440
