{
  "name": "synapsegrid",
  "version": "1.0.0",
  "description": "SynapseGrid - Advanced Cybernetic Workstation with Multi-Language Compiler, Autonomous Prime Agent RLM, and Host Telemetry",
  "main": "dist/main/main.js",
  "homepage": "https://github.com/DeepxkJadhav/SYNAPSE-GRID",
  "author": "Deepak Jadhav <deepak.s.jadhav07@gmail.com>",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/frontend",
    "packages/backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @synapse/backend\" \"npm run dev -w @synapse/frontend\"",
    "dev:desktop": "concurrently \"npm run dev -w @synapse/backend\" \"npm run dev -w @synapse/frontend\" \"electron .\"",
    "build": "npm run build -w @synapse/backend && npm run build -w @synapse/frontend && npm run build:desktop",
    "build:desktop": "node -e \"const fs=require('fs');fs.rmSync('dist/main',{recursive:true,force:true});\" && tsc -p tsconfig.main.json",
    "electron-dev": "electron .",
    "electron-build": "npm run build && electron-builder --win --publish never",
    "dist": "npm run build && electron-builder --win msi nsis",
    "pack": "electron-builder --dir",
    "test": "npm run test -w @synapse/backend",
    "lint": "npm run lint -w @synapse/backend && npm run lint -w @synapse/frontend",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules dist packages/frontend/out"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "concurrently": "^8.2.0",
    "electron": "^27.3.11",
    "electron-builder": "^24.6.4",
    "electron-is-dev": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.synapsegrid.app",
    "productName": "SynapseGrid",
    "files": [
      "dist/main/**/*",
      "packages/frontend/out/**/*",
      "packages/backend/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SynapseGrid-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SynapseGrid"
    },
    "portable": {
      "artifactName": "SynapseGrid-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "DeepxkJadhav",
      "repo": "SYNAPSE-GRID",
      "releaseType": "draft"
    }
  }
}
